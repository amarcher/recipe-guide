// Recipe Guide — persistence layer.
// Auth.js (v5) + Prisma adapter required models, plus our domain models.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js (v5) required models ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  familyMemberships FamilyMember[]
  savedRecipes  SavedRecipe[]
  miseChecks    MiseCheck[]
  cookLogs      CookLog[]
  weeklyPlans   WeeklyPlan[]    @relation("WeeklyPlanCreator")
  purchasedGroceryItems GroceryItem[] @relation("GroceryPurchaser")
  instagramConnection InstagramConnection?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Families (multi-user shared libraries) ─────────────────────────────────

enum FamilyRole {
  OWNER
  ADMIN
  MEMBER
}

model Family {
  id            String   @id @default(cuid())
  name          String
  createdAt     DateTime @default(now())
  syncExecution Boolean  @default(true)

  members FamilyMember[]
  invites FamilyInvite[]
  recipes SavedRecipe[]
  plans   WeeklyPlan[]
}

model FamilyMember {
  id       String     @id @default(cuid())
  userId   String
  familyId String
  role     FamilyRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([familyId])
}

model FamilyInvite {
  id          String    @id @default(cuid())
  familyId    String
  code        String    @unique
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  createdAt   DateTime  @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

// ─── Recipe data ────────────────────────────────────────────────────────────

// Cross-account cache: one entry per source URL, holds the parsed CookCard
// JSON. Anyone who pastes the same URL gets the cached parse — no Claude call.
// Append a query param to the URL to bust the cache (becomes a new entry).
model ParsedRecipe {
  id           String   @id @default(cuid())
  sourceUrl    String   @unique
  title        String
  cardJson     Json
  parsedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt
  modelUsed    String
  modelVersion String?

  saves SavedRecipe[]

  @@index([sourceUrl])
}

// One per (user, parsedRecipe, scope). Scope = personal (familyId null) or
// a specific family. The same recipe can live in your personal library AND
// in multiple families simultaneously, each with its own cook count.
model SavedRecipe {
  id             String    @id @default(cuid())
  parsedRecipeId String
  userId         String
  familyId       String?
  savedAt        DateTime  @default(now())
  lastCookedAt   DateTime?
  cookCount      Int       @default(0)

  parsedRecipe ParsedRecipe @relation(fields: [parsedRecipeId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  family       Family?      @relation(fields: [familyId], references: [id], onDelete: Cascade)

  miseChecks MiseCheck[]
  cookLogs   CookLog[]

  @@unique([userId, parsedRecipeId, familyId])
  @@index([userId])
  @@index([familyId])
}

// Per-user mise-en-place checks within a saved recipe. Even in a shared
// family recipe, each member tracks their own "I have it on the counter".
model MiseCheck {
  id            String   @id @default(cuid())
  savedRecipeId String
  userId        String
  entryKey      String
  checkedAt     DateTime @default(now())

  savedRecipe SavedRecipe @relation(fields: [savedRecipeId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([savedRecipeId, userId, entryKey])
  @@index([savedRecipeId, userId])
}

// ─── Cook log (per-attempt history, photos) ────────────────────────────────
// One row per "I cooked this" event. Photos attach here — a family with
// multiple attempts retains the history. Latest row's photoUrl is what the
// library card renders as its thumbnail.
model CookLog {
  id               String    @id @default(cuid())
  savedRecipeId    String
  userId           String
  cookedAt         DateTime  @default(now())
  photoUrl         String?
  photoUploadedAt  DateTime?
  videoUrl         String?
  videoAspectRatio Float?
  notes            String?
  instagramPostId  String?   @unique

  savedRecipe SavedRecipe @relation(fields: [savedRecipeId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramPost InstagramPost? @relation(fields: [instagramPostId], references: [id], onDelete: SetNull)

  @@index([savedRecipeId, cookedAt])
  @@index([userId, cookedAt])
}

// ─── Weekly meal planner ────────────────────────────────────────────────────
// The week is a menu, not a calendar: committed meals are a pickable queue,
// day assignment is deferred to cook-night. See memory:
// project_menu_not_calendar.md for the rationale.

enum PlanStatus {
  DRAFT
  INTAKE_COMPLETE
  SKELETON_READY
  CANDIDATES_READY
  COMMITTED
  ACTIVE
  ARCHIVED
}

enum MealSlotType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum Eater {
  ADULTS
  KIDS
}

enum PlannedMealStatus {
  QUEUED
  COOKED
  SKIPPED
}

enum KidFitTag {
  RELIABLE
  STRETCH
  NEW
}

enum IntakeRole {
  USER
  ASSISTANT
}

model WeeklyPlan {
  id          String     @id @default(cuid())
  familyId    String?
  createdById String
  weekOf      DateTime
  status      PlanStatus @default(DRAFT)
  intake      Json?
  skeleton    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  family     Family?         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy  User            @relation("WeeklyPlanCreator", fields: [createdById], references: [id], onDelete: Cascade)
  meals      PlannedMeal[]
  candidates MealCandidate[]
  groceries  GroceryItem[]
  messages   IntakeMessage[]

  @@index([familyId])
  @@index([createdById])
  @@index([status])
}

// A proposal for a meal in a plan. Generated in bulk (3-5 per slot/eaters
// combo) by the per-slot LLM call, then scored and ranked deterministically.
// Becomes a PlannedMeal if the user commits to it.
model MealCandidate {
  id                  String       @id @default(cuid())
  planId              String
  slot                MealSlotType
  eaters              Eater[]
  title               String
  summary             String
  rationale           String
  heroIngredientSlugs String[]     @default([])
  approxCookMinutes   Int
  kidFitTag           KidFitTag    @default(RELIABLE)
  composedCardDraft   Json
  rank                Int?
  score               Float?
  filteredOutReason   String?
  scoreBreakdownJson  Json?
  badges              String[]     @default([])
  rankedAt            DateTime?
  discardedAt         DateTime?
  createdAt           DateTime     @default(now())

  plan         WeeklyPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  plannedMeals PlannedMeal[]

  @@index([planId, slot])
  @@index([planId, rank])
}

// A committed meal in the plan. One row per (eaters) slice — on split
// adult/kid nights we get two rows, which is deliberate (see memory:
// project_slot_schema_decision.md).
model PlannedMeal {
  id                String            @id @default(cuid())
  planId            String
  chosenCandidateId String
  slot              MealSlotType
  eaters            Eater[]
  status            PlannedMealStatus @default(QUEUED)
  targetDay         Int?
  cookedAt          DateTime?
  skippedAt         DateTime?
  notes             String?
  createdAt         DateTime          @default(now())

  plan      WeeklyPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  candidate MealCandidate @relation(fields: [chosenCandidateId], references: [id], onDelete: Restrict)

  @@index([planId, status])
  @@index([chosenCandidateId])
}

// Aggregated grocery line item for a plan. Computed on commit/uncommit of
// PlannedMeal rows, deduped by (planId, slug, unit).
model GroceryItem {
  id            String    @id @default(cuid())
  planId        String
  slug          String?
  display       String
  unit          String?
  quantity      String?
  purchased     Boolean   @default(false)
  purchasedAt   DateTime?
  purchasedById String?

  plan        WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  purchasedBy User?      @relation("GroceryPurchaser", fields: [purchasedById], references: [id])

  @@index([planId, purchased])
  @@index([planId, slug])
}

// ─── Instagram ingestion ───────────────────────────────────────────────────
// Per-user connection to the IG Graph API. One IG account → one connection
// row. Long-lived access tokens last ~60 days and must be refreshed before
// they expire. Imports currently land in the connecting user's personal
// library; family-scoped imports are a phase-3 addition.

model InstagramConnection {
  id                 String    @id @default(cuid())
  userId             String    @unique
  instagramAccountId String
  username           String?
  accessToken        String    @db.Text
  tokenExpiresAt     DateTime?
  lastSyncedAt       DateTime?
  lastSyncError      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts InstagramPost[]

  @@index([userId])
}

// Cache of every IG post we've seen for a connection. Dedup key is the IG
// media ID. Rehosted Blob URLs are the source of truth for rendering —
// Instagram CDN URLs expire in hours.
model InstagramPost {
  id               String    @id @default(cuid())
  connectionId     String
  postId           String    @unique
  permalink        String
  postedAt         DateTime
  caption          String?   @db.Text
  mediaType        String
  mediaBlobUrl     String?
  videoBlobUrl     String?
  thumbnailBlobUrl String?
  aspectRatio      Float?
  savedRecipeId    String?
  processedAt      DateTime?
  processingError  String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  connection InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  cookLog    CookLog?

  @@index([connectionId, postedAt])
}

// Raw transcript of the intake conversation. The structured PlanIntake lives
// in WeeklyPlan.intake; this is the ground truth for re-extraction.
model IntakeMessage {
  id        String     @id @default(cuid())
  planId    String
  role      IntakeRole
  content   String
  createdAt DateTime   @default(now())

  plan WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
}
