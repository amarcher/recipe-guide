{
  "name": "recipe-guide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:llm-schemas": "node --import tsx scripts/validate-llm-schemas.ts",
    "sprites": "node --env-file=.env.local scripts/generate-sprites.mjs",
    "sprites:download-originals": "node --env-file=.env.local --import tsx scripts/download-sprite-originals.ts",
    "sprites:delete-originals": "node --env-file=.env.local --import tsx scripts/delete-sprite-originals.ts",
    "sprites:promote": "node --env-file=.env.local scripts/promote-static-to-blob.mjs",
    "seed:demo-plan": "node --env-file=.env.local --import tsx scripts/seed-demo-plan.ts",
    "backfill:taglines": "node --env-file=.env.local --import tsx scripts/backfill-taglines.ts",
    "backfill:override-dish-photos": "node --env-file=.env.local --import tsx scripts/backfill-override-dish-photos.ts",
    "dish-photos": "node --env-file=.env.local --import tsx scripts/generate-dish-photos.ts",
    "candidate-dish-photos": "node --env-file=.env.local --import tsx scripts/generate-candidate-dish-photos.ts",
    "pivot-sweep": "node --env-file=.env.local --import tsx scripts/pivot-sweep.ts",
    "verify:prod-migration": "node --env-file=.env.local --import tsx scripts/verify-prod-migration.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/react": "^3.0.170",
    "@anthropic-ai/sdk": "^0.90.0",
    "@auth/prisma-adapter": "^2.11.2",
    "@mendable/firecrawl-js": "^4.22.1",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@vercel/blob": "^2.3.3",
    "ai": "^6.0.168",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "prisma": "^7.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
