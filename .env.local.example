ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Shared secret for scheduled cron routes under /api/cron/* (first user:
# the abandoned-pivot sweep). Set the same value in the Vercel project env;
# Vercel injects `Authorization: Bearer <CRON_SECRET>` on scheduled hits.
# Routes fail closed (503) when this is unset. Pick any random string.
# CRON_SECRET=

# Optional: when set in dev, POST /api/dev/auth with `Authorization: Bearer <token>`
# mints a session cookie for headless agents (verify-ui skill, smoke tests).
# Pick any random string. The route is hard-blocked when NODE_ENV=production
# and when this var is empty, so leave it unset outside of local dev.
# DEV_AUTH_TOKEN=
